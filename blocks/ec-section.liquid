{%- liquid
  assign inherit = block.settings.inherit_color_scheme
  assign scheme = block.settings.color_scheme
  assign label = block.settings.title | default: ''
  assign show_label = block.settings.show_label
-%}
{%- comment -%}
  Per-block wrapper. By default it INHERITS the colour scheme from the parent
  ec-blocks root (no own class / no own --ec-* mapping → the root's --color-* and
  --ec-* cascade straight through). Untick "Inherit colour scheme" to override
  just this section: it then paints its own scheme (color-{{ scheme }} class) and
  re-aliases --color-* → --ec-* locally. So: change the root → every inheriting
  section follows; change one section → only that one.
{%- endcomment -%}
<div
  class="ec-section{% unless inherit %} color-{{ scheme }}{% endunless %}"
  {{ block.shopify_attributes }}
  style="{% unless inherit %}--ec-bg:var(--color-background,#fff);--ec-bg-soft:var(--color-background,#fafafa);--ec-fg:var(--color-foreground,#111);--ec-fg-sec:var(--color-foreground-muted,#535862);--ec-border:var(--color-border,rgba(0,0,0,.08));--ec-divider:var(--color-border,rgba(0,0,0,.06));--ec-accent:var(--color-primary,#000);--ec-accent-soft:rgb(var(--color-primary-rgb,0 0 0) / .1);--ec-accent-fg:var(--color-primary-button-text,#fff);--ec-success:var(--color-primary,#000);--ec-success-soft:rgb(var(--color-primary-rgb,0 0 0) / .1);{% endunless %}display:flex;flex-direction:column;background:var(--ec-bg);color:var(--ec-fg);"
>
  {%- if show_label and label != blank -%}
    <div class="ec-blocks__label" style="display:flex;align-items:center;gap:8px;padding:8px 16px;margin:0;font:600 11px/1 ui-monospace,monospace;letter-spacing:.05em;text-transform:uppercase;color:#6b7280;background:#f3f4f6;border-block:1px solid #e5e7eb;">
      <span aria-hidden="true">▸</span>{{ label }}
    </div>
  {%- endif -%}
  {% content_for 'blocks' %}
</div>

{% schema %}
{
  "name": "EC Section",
  "tag": null,
  "blocks": [
    { "type": "@app" }
  ],
  "settings": [
    {
      "type": "text",
      "id": "title",
      "label": "Block name",
      "info": "Shown as this section's name in the theme editor (id 'title' is auto-used by the editor as the block label)."
    },
    {
      "type": "checkbox",
      "id": "show_label",
      "label": "Show name as a label on the storefront",
      "info": "Off by default. Used by the block-showcase view to identify each block on the page.",
      "default": false
    },
    {
      "type": "header",
      "content": "Appearance"
    },
    {
      "type": "checkbox",
      "id": "inherit_color_scheme",
      "label": "Inherit colour scheme from the section",
      "info": "On: follows the EC Blocks root scheme. Off: pick a scheme just for this block.",
      "default": true
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "t:settings.color_scheme",
      "default": "scheme-1",
      "visible_if": "{{ block.settings.inherit_color_scheme == false }}"
    }
  ]
}
{% endschema %}
