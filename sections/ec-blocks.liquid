{%- liquid
  assign width = section.settings.section_width | default: 'full-width'
  assign gap = section.settings.gap | default: 0
  assign pt = section.settings.padding_block_start | default: 0
  assign pb = section.settings.padding_block_end | default: 0
  assign niche = section.settings.niche | default: '' | downcase
-%}
{%- if niche != blank -%}
  <style>
    {%- case niche -%}
      {%- when 'beauty', 'skincare', 'cosmetic', 'derma' -%}
        :root { --ec-accent: #c8775a; --ec-accent-soft: rgba(200,119,90,.1); }
      {%- when 'electronic', 'electronics', 'gadget', 'tech', 'device', 'appliance' -%}
        :root { --ec-accent: #0066ff; --ec-accent-soft: rgba(0,102,255,.08); }
      {%- when 'health', 'fitness', 'supplement', 'vitamin', 'wellness' -%}
        :root { --ec-accent: #10894e; --ec-accent-soft: rgba(16,137,78,.1); --ec-success: #10894e; }
      {%- when 'apparel', 'fashion', 'clothing', 'footwear', 'shoes', 'outdoor', 'winter' -%}
        :root { --ec-accent: #000000; --ec-accent-soft: rgba(0,0,0,.06); }
      {%- when 'home', 'kitchen', 'furniture', 'decor' -%}
        :root { --ec-accent: #8b5a3c; --ec-accent-soft: rgba(139,90,60,.08); }
      {%- when 'food', 'pet', 'baby', 'kids' -%}
        :root { --ec-accent: #d97706; --ec-accent-soft: rgba(217,119,6,.08); }
    {%- endcase -%}
  </style>
{%- endif -%}
{%- comment -%}
  Section colour comes from the theme's native color scheme (color-{{ scheme }}
  class), which defines --color-background / --color-foreground / --color-border
  on this wrapper. We alias those into the --ec-* custom properties the EC blocks
  consume, so every block inherits the merchant-selected scheme. The niche block
  above may still override --ec-accent for category-driven theming.
{%- endcomment -%}
<div
  class="ec-blocks ec-blocks--{{ width }} color-{{ section.settings.color_scheme }}"
  data-ec-niche="{{ niche }}"
  data-ec-section-id="{{ section.id }}"
  style="--ec-bg:var(--color-background,#fff);--ec-bg-soft:var(--color-background,#fafafa);--ec-fg:var(--color-foreground,#111);--ec-fg-sec:var(--color-foreground-muted,#535862);--ec-border:var(--color-border,rgba(0,0,0,.08));--ec-divider:var(--color-border,rgba(0,0,0,.06));--ec-accent-fg:#fff;display:flex;flex-direction:column;width:100%;gap:{{ gap }}px;padding-block-start:{{ pt }}px;padding-block-end:{{ pb }}px;background:var(--ec-bg);color:var(--ec-fg);"
>
  {% content_for 'blocks' %}
</div>

{% schema %}
{
  "name": "EC Blocks",
  "class": "ec-blocks-wrapper",
  "blocks": [
    { "type": "ec-section" },
    { "type": "@app" }
  ],
  "settings": [
    {
      "type": "select",
      "id": "section_width",
      "label": "Width",
      "options": [
        { "value": "full-width", "label": "Full width" },
        { "value": "page-width", "label": "Page width" }
      ],
      "default": "full-width"
    },
    {
      "type": "range",
      "id": "gap",
      "label": "Gap between blocks",
      "min": 0, "max": 100, "step": 1, "unit": "px",
      "default": 0
    },
    {
      "type": "range",
      "id": "padding_block_start",
      "label": "Top padding",
      "min": 0, "max": 100, "step": 1, "unit": "px",
      "default": 0
    },
    {
      "type": "range",
      "id": "padding_block_end",
      "label": "Bottom padding",
      "min": 0, "max": 100, "step": 1, "unit": "px",
      "default": 0
    },
    {
      "type": "text",
      "id": "niche",
      "label": "Niche slug (drives accent palette)",
      "info": "beauty / electronic / health / apparel / home / food — applied as data-ec-niche + :root vars"
    },
    {
      "type": "header",
      "content": "Appearance"
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "t:settings.color_scheme",
      "default": "scheme-1"
    }
  ],
  "presets": [
    { "name": "EC Blocks", "category": "Layout" }
  ]
}
{% endschema %}
